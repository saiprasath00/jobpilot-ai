AI_PROVIDER=mwapi
MWAPI_API_KEY=
# Codespaces may alternatively expose the provider key as API_KEY.
API_KEY=
# Supported for an existing Codespaces secret named API.
API=
MWAPI_MODEL=claude-sonnet-4-6
# Optional alternate provider: set AI_PROVIDER=openai to use these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
HOST=127.0.0.1
PORT=3000
# Required for remote access; put this service behind HTTPS.
APP_PASSWORD=
APP_ORIGIN=
